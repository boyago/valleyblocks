# Plataforma Vale dos Blocos. Copie para .env.local (dev) ou configure no painel da hospedagem.
# Variáveis NEXT_PUBLIC_* precisam existir no momento do build.

# Domínio canônico, sem barra final (sitemap, canonical, Open Graph). Obrigatório em produção.
NEXT_PUBLIC_SITE_URL=https://SEU-DOMINIO
LABS_ORIGIN=https://SEU-DOMINIO
CONTACT_EMAIL=app.boyago@gmail.com

# Banco exclusivo do Vale dos Blocos (MySQL). Em dev pode usar SQLite: LABS_USAGE_SQLITE_PATH=./.local/vale.sqlite
LABS_MYSQL_HOST=
LABS_MYSQL_PORT=3306
LABS_MYSQL_DATABASE=
LABS_MYSQL_USER=
LABS_MYSQL_PASSWORD=
LABS_MYSQL_TLS=true
# Segredo aleatório, >= 32 caracteres, persistente. Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
LABS_USAGE_SECRET=

# Recursos (servidor + build)
LABS_ACCOUNTS_ENABLED=true
LABS_PLAY_ENABLED=true
NEXT_PUBLIC_LABS_PLAY_ENABLED=true
LABS_SIGNUP_ENABLED=true
NEXT_PUBLIC_LABS_SIGNUP_ENABLED=true
LABS_WORLDS_ENABLED=true
NEXT_PUBLIC_LABS_WORLDS_ENABLED=true
LABS_MULTIPLAYER_ENABLED=true
NEXT_PUBLIC_LABS_MULTIPLAYER_ENABLED=true
LABS_USAGE_ENABLED=false
NEXT_PUBLIC_LABS_USAGE_ENABLED=false

# E-mail (confirmação de conta, recuperação de senha, compra)
LABS_SMTP_HOST=
LABS_SMTP_PORT=587
LABS_SMTP_USER=
LABS_SMTP_PASSWORD=
LABS_MAIL_FROM=

# Pagamentos Mercado Pago (Checkout Pro). Desligado até ter credenciais.
LABS_PAYMENTS_ENABLED=false
NEXT_PUBLIC_LABS_PAYMENTS_ENABLED=false
LABS_MP_ACCESS_TOKEN=
LABS_MP_WEBHOOK_SECRET=

# Opcionais
# LABS_TRUSTED_PROXIES=
# NEXT_PUBLIC_GA_MEASUREMENT_ID=
# GOOGLE_SITE_VERIFICATION=
